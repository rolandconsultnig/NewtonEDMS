# Copy to .env and adjust. All variables use the EDMS_ prefix.
# IMPORTANT: set EDMS_SECRET_KEY to a long random string in production.

EDMS_SECRET_KEY=newedms-dev-secret-DO-NOT-USE-IN-PRODUCTION
EDMS_ACCESS_TOKEN_EXPIRE_MINUTES=240
# Leave empty to use the default local SQLite file (./edms.db)
EDMS_DATABASE_URL=
EDMS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Leave empty to use ./storage
EDMS_STORAGE_DIR=
EDMS_MAX_UPLOAD_BYTES=52428800
EDMS_BLOCKED_EXTENSIONS=exe,bat,cmd,com,sh,ps1,js,vbs,msi,dll,scr,jar,wsf,hta,php,pl,py
EDMS_LOGIN_RATE_LIMIT=5/minute
EDMS_REGISTER_RATE_LIMIT=10/hour
EDMS_PASSWORD_MIN_LENGTH=8

# First-boot seeding only. Change immediately after install.
EDMS_SEED_ADMIN_USERNAME=admin
EDMS_SEED_ADMIN_PASSWORD=admin123

# Auth cookie (HttpOnly; SameSite=Lax mitigates CSRF). Behind HTTPS, set EDMS_COOKIE_SECURE=true.
EDMS_COOKIE_NAME=edms_token
EDMS_COOKIE_SECURE=false
EDMS_COOKIE_SAMESITE=lax
